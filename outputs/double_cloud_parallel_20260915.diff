+def _jacobian(params, vel, intensity, background, scale):
+    """残差对 [ltauL,ltauU,vL,vU,lWL,lWU,SL,SU] 的解析导数。"""
+    ltauL, ltauU, vL, vU, lWL, lWU, SL, SU = params
+    WL, WU = np.exp(lWL), np.exp(lWU)
+    zL, zU = (vel - vL) / WL, (vel - vU) / WU
+    tauL, tauU = np.exp(ltauL - zL**2), np.exp(ltauU - zU**2)
+    eL, eU = np.exp(-tauL), np.exp(-tauU)
+    aL, aU = -np.expm1(-tauL), -np.expm1(-tauU)
+    below_upper = background * eL + SL * aL
+    commonL = (SL - background) * np.exp(-(tauL + tauU)) * tauL
+    commonU = (SU - below_upper) * eU * tauU
+    return np.column_stack((commonL, commonU, commonL * 2 * zL / WL, commonU * 2 * zU / WU, commonL * 2 * zL**2, commonU * 2 * zU**2, aL * eU, aU)) / scale
 
 
